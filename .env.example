# ─────────────────────────────────────────────────────────────
# NEXPHONE — Variables de entorno
# Copia este archivo como .env.local (desarrollo) y configúralas en Vercel (producción).
# Las variables NEXT_PUBLIC_* son visibles en el navegador: nunca pongas secretos en ellas.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). En Vercel es OPCIONAL: si falta se usa el dominio
# de producción del proyecto automáticamente. Defínela cuando conectes un dominio propio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo del primer administrador. Al registrarse y confirmar ese correo, la cuenta pasa a ser
# administradora automáticamente (solo mientras no exista ningún administrador).
ADMIN_EMAIL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SECRETO (solo servidor). Lo usan el webhook de pagos y la verificación de retorno.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Conexión directa a PostgreSQL (SECRETO). Con ella, `npm run build` crea/actualiza la base de datos
# automáticamente (migraciones idempotentes, sin borrar datos). La integración Supabase de Vercel
# la define sola como POSTGRES_URL_NON_POOLING; también se acepta DATABASE_URL.
# POSTGRES_URL_NON_POOLING=postgres://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Mercado Pago (Perú) → Tus integraciones → Credenciales
# Usa primero las credenciales de PRUEBA (empiezan con TEST-). SECRETO.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Clave secreta del webhook (Tus integraciones → Webhooks). Obligatoria en producción.
MP_WEBHOOK_SECRET=
# Opcional: URL pública del webhook si difiere de NEXT_PUBLIC_SITE_URL/api/webhooks/mercadopago
MP_NOTIFICATION_URL=

# Poner en 1 solo cuando integres un proveedor OSE/PSE de facturación electrónica SUNAT
SUNAT_EINVOICING_ENABLED=0

# Solo para generar renders de producto en un entorno de producción local (no en Vercel)
ENABLE_RENDER_STUDIO=0
